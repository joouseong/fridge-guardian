<%- include('partials/header', { title: '대시보드' }) %>

<div class="page-title-row">
  <div>
    <span class="eyebrow">MY FRIDGE</span>
    <h1><%= user.name %>님의 냉장고</h1>
  </div>
  <a href="/ingredients/new" class="btn">+ 식재료 등록</a>
</div>

<section class="stats-grid">
  <div class="stat-card">
    <span>전체 식재료</span>
    <strong><%= stats.total %></strong>
    <small>개</small>
  </div>
  <div class="stat-card warning-border">
    <span>3일 이내 임박</span>
    <strong><%= stats.expiringSoon %></strong>
    <small>개</small>
  </div>
  <div class="stat-card danger-border">
    <span>유통기한 만료</span>
    <strong><%= stats.expired %></strong>
    <small>개</small>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>유통기한이 가까운 식재료</h2>
      <p class="muted">유통기한이 빠른 순서로 표시됩니다.</p>
    </div>
    <a href="/ingredients">전체 보기 →</a>
  </div>

  <% if (ingredients.length === 0) { %>
    <div class="empty">
      <p>등록된 식재료가 없습니다.</p>
      <a href="/ingredients/new" class="btn btn-outline">첫 식재료 등록하기</a>
    </div>
  <% } else { %>
    <div class="ingredient-grid">
      <% ingredients.forEach(item => { %>
        <article class="ingredient-card">
          <div class="ingredient-image">
            <% if (item.image_path) { %>
              <img src="<%= item.image_path %>" alt="<%= item.name %>">
            <% } else { %>
              <div class="placeholder">🥬</div>
            <% } %>
          </div>
          <div class="ingredient-body">
            <div class="row-between">
              <h3><%= item.name %></h3>
              <% if (item.dday < 0) { %>
                <span class="badge badge-danger">D+<%= Math.abs(item.dday) %></span>
              <% } else if (item.dday <= 3) { %>
                <span class="badge badge-warning">D-<%= item.dday %></span>
              <% } else { %>
                <span class="badge badge-safe">D-<%= item.dday %></span>
              <% } %>
            </div>
            <p><%= item.quantity %><%= item.unit %> · <%= item.storage_location %></p>
            <small>유통기한 <%= item.expiry_date %></small>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="panel callout">
  <div>
    <h2>지금 있는 재료로 무엇을 만들 수 있을까요?</h2>
    <p>보유한 식재료와 가장 잘 맞는 레시피부터 추천해드립니다.</p>
  </div>
  <a class="btn" href="/recipes">레시피 추천 보기</a>
</section>

<%- include('partials/footer') %>
