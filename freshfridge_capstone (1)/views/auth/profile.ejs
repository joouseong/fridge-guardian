<%- include('../partials/header') %>

<div class="profile-container card">
  <h2>개인 설정</h2>
  <p class="subtitle">계정 정보 조회 및 비밀번호 변경을 진행할 수 있습니다.</p>

  <form action="/auth/profile" method="POST" class="profile-form">
    <!-- 이름 수정 -->
    <div class="form-group">
      <label for="name">이름</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        value="<%= profileUser.name %>" 
        required
      />
    </div>

    <!-- 이메일 (수정 불가) -->
    <div class="form-group">
      <label for="email">이메일 계정</label>
      <input 
        type="email" 
        id="email" 
        value="<%= profileUser.email %>" 
        disabled 
        class="input-disabled"
      />
      <small class="help-text">이메일은 변경할 수 없습니다.</small>
    </div>

    <!-- 비밀번호 변경 영역 (일반 회원가입 유저만 해당) -->
    <% if (profileUser.password_hash) { %>
      <hr class="divider" />
      <h3>비밀번호 변경</h3>
      <p class="help-text">비밀번호를 변경할 때만 입력해주세요.</p>

      <div class="form-group">
        <label for="currentPassword">현재 비밀번호</label>
        <input 
          type="password" 
          id="currentPassword" 
          name="currentPassword" 
          placeholder="현재 비밀번호 입력"
        />
      </div>

      <div class="form-group">
        <label for="newPassword">새 비밀번호</label>
        <input 
          type="password" 
          id="newPassword" 
          name="newPassword" 
          placeholder="6자 이상 입력"
        />
      </div>

      <div class="form-group">
        <label for="newPasswordConfirm">새 비밀번호 확인</label>
        <input 
          type="password" 
          id="newPasswordConfirm" 
          name="newPasswordConfirm" 
          placeholder="새 비밀번호 재입력"
        />
      </div>
    <% } else { %>
      <hr class="divider" />
      <div class="social-notice">
        <p>🔒 <strong>소셜 로그인 계정</strong>(구글/카카오)으로 가입된 사용자입니다.<br>비밀번호 변경은 해당 소셜 서비스에서 가능합니다.</p>
      </div>
    <% } %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">정보 수정 저장</button>
      <a href="/dashboard" class="btn btn-secondary">취소</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>