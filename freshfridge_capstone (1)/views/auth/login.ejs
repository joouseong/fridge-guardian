<%- include('../partials/header', { title: '로그인' }) %>
<section class="auth-wrap">
  <div class="auth-card">
    <h1>로그인</h1>
    <p class="muted">내 냉장고 식재료를 관리해보세요.</p>
    <form action="/auth/login" method="POST" class="form">
      <label>이메일
        <input type="email" name="email" placeholder="example@email.com" required>
      </label>
      <label>비밀번호
        <input type="password" name="password" placeholder="비밀번호" required>
      </label>
      <button class="btn btn-full" type="submit">로그인</button>
    </form>

    <!-- 소셜 로그인 영역 -->
    <div class="social-login">
      <p>또는</p>
      <a href="/auth/google" class="btn btn-full">Google 계정으로 로그인</a>
      <a href="/auth/kakao" class="btn btn-full" style="margin-top: 10px; background-color: #FEE500; color: #000000;">카카오로 로그인</a>
    </div>

    <p class="auth-bottom">계정이 없나요? <a href="/auth/register">회원가입</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
