<%- include('../partials/header', { title: '식재료 관리' }) %>

<div class="page-title-row">
  <div>
    <span class="eyebrow">INGREDIENTS</span>
    <h1>식재료 관리</h1>
  </div>
  <a href="/ingredients/new" class="btn">+ 식재료 등록</a>
</div>

<section class="panel">
  <form method="GET" action="/ingredients" class="search-bar">
    <input type="text" name="keyword" value="<%= keyword %>" placeholder="식재료 이름, 카테고리, 보관 위치 검색">
    <select name="status">
      <option value="">전체 상태</option>
      <option value="soon" <%= status === 'soon' ? 'selected' : '' %>>3일 이내 임박</option>
      <option value="safe" <%= status === 'safe' ? 'selected' : '' %>>여유 있음</option>
      <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>유통기한 만료</option>
    </select>
    <button class="btn" type="submit">검색</button>
    <a class="btn btn-outline" href="/ingredients">초기화</a>
  </form>
</section>

<section class="panel">
  <% if (ingredients.length === 0) { %>
    <div class="empty">
      <p>조건에 맞는 식재료가 없습니다.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>사진</th>
            <th>식재료</th>
            <th>분류</th>
            <th>수량</th>
            <th>보관</th>
            <th>유통기한</th>
            <th>상태</th>
            <th>관리</th>
          </tr>
        </thead>
        <tbody>
          <% ingredients.forEach(item => { %>
            <tr>
              <td>
                <% if (item.image_path) { %>
                  <img class="thumb" src="<%= item.image_path %>" alt="">
                <% } else { %>
                  <div class="thumb placeholder-sm">🥕</div>
                <% } %>
              </td>
              <td><strong><%= item.name %></strong></td>
              <td><%= item.category || '-' %></td>
              <td><%= item.quantity %><%= item.unit %></td>
              <td><%= item.storage_location %></td>
              <td><%= item.expiry_date %></td>
              <td>
                <% if (item.dday < 0) { %>
                  <span class="badge badge-danger">만료 D+<%= Math.abs(item.dday) %></span>
                <% } else if (item.dday <= 3) { %>
                  <span class="badge badge-warning">임박 D-<%= item.dday %></span>
                <% } else { %>
                  <span class="badge badge-safe">D-<%= item.dday %></span>
                <% } %>
              </td>
              <td class="actions">
                <a href="/ingredients/<%= item.id %>/edit" class="text-btn">수정</a>
                <form action="/ingredients/<%= item.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('정말 삭제할까요?')">
                  <button type="submit" class="text-btn danger-text">삭제</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
