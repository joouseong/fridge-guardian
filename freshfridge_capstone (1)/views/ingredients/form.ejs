<%- include('../partials/header', { title: ingredient ? '식재료 수정' : '식재료 등록' }) %>

<div class="page-title-row">
  <div>
    <span class="eyebrow">INGREDIENT FORM</span>
    <h1><%= ingredient ? '식재료 수정' : '식재료 등록' %></h1>
  </div>
  <a href="/ingredients" class="btn btn-outline">목록으로</a>
</div>

<section class="panel form-panel">
  <form
    action="<%= ingredient ? '/ingredients/' + ingredient.id + '/edit' : '/ingredients' %>"
    method="POST"
    enctype="multipart/form-data"
    class="form grid-form"
  >
    <label>식재료 이름 *
      <input type="text" name="name" value="<%= ingredient ? ingredient.name : '' %>" placeholder="예: 계란" required>
    </label>

    <label>카테고리
      <select name="category">
        <% const cats = ['채소','과일','육류','수산물','유제품','곡류','가공식품','조미료','기타']; %>
        <option value="">선택</option>
        <% cats.forEach(c => { %>
          <option value="<%= c %>" <%= ingredient && ingredient.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </label>

    <label>수량
      <input type="number" step="0.1" min="0" name="quantity" value="<%= ingredient ? ingredient.quantity : '1' %>">
    </label>

    <label>단위
      <select name="unit">
        <% const units = ['개','팩','병','봉','g','kg','ml','L']; %>
        <% units.forEach(u => { %>
          <option value="<%= u %>" <%= ingredient && ingredient.unit === u ? 'selected' : '' %>><%= u %></option>
        <% }) %>
      </select>
    </label>

    <label>구매일
      <input type="date" name="purchase_date" value="<%= ingredient && ingredient.purchase_date ? ingredient.purchase_date : '' %>">
    </label>

    <label>유통기한 *
      <input type="date" name="expiry_date" value="<%= ingredient ? ingredient.expiry_date : '' %>" required>
    </label>

    <label>보관 위치
      <select name="storage_location">
        <% ['냉장','냉동','실온'].forEach(s => { %>
          <option value="<%= s %>" <%= ingredient && ingredient.storage_location === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </label>

    <label>사진
      <input type="file" name="image" accept="image/*">
      <% if (ingredient && ingredient.image_path) { %>
        <small>새 사진을 선택하지 않으면 기존 사진이 유지됩니다.</small>
      <% } %>
    </label>

    <label class="full">메모
      <textarea name="memo" rows="4" placeholder="예: 계란 10구, 이번 주 안에 사용"><%= ingredient && ingredient.memo ? ingredient.memo : '' %></textarea>
    </label>

    <div class="full form-actions">
      <button class="btn" type="submit"><%= ingredient ? '수정 저장' : '식재료 등록' %></button>
      <a href="/ingredients" class="btn btn-outline">취소</a>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
