<%- include('../partials/header', { title: '레시피 추천' }) %>

<div class="page-title-row">
  <div>
    <span class="eyebrow">RECIPE MATCH</span>
    <h1>보유 재료 기반 레시피 추천</h1>
    <p class="muted">현재 유통기한이 지나지 않은 보유 식재료 <strong><%= ownedCount %>개</strong>를 기준으로 계산했습니다.</p>
  </div>
</div>

<section class="recipe-grid">
  <% recipes.forEach((recipe, index) => { %>
    <article class="recipe-card">
      <div class="recipe-top">
        <div>
          <% if (index === 0 && recipe.matchRate > 0) { %>
            <span class="best-label">BEST MATCH</span>
          <% } %>
          <h2><%= recipe.name %></h2>
          <p><%= recipe.description %></p>
        </div>
        <div class="match-circle"><strong><%= recipe.matchRate %>%</strong><span>일치</span></div>
      </div>

      <div class="recipe-meta">
        <span>⏱ <%= recipe.cooking_time %>분</span>
        <span>난이도 <%= recipe.difficulty %></span>
      </div>

      <div class="ingredient-tags">
        <% recipe.ingredientList.forEach(i => { %>
          <span class="tag <%= recipe.matched.includes(i) ? 'tag-have' : 'tag-missing' %>">
            <%= recipe.matched.includes(i) ? '✓' : '+' %> <%= i %>
          </span>
        <% }) %>
      </div>

      <% if (recipe.missing.length > 0) { %>
        <p class="missing-text">추가로 필요한 재료: <strong><%= recipe.missing.join(', ') %></strong></p>
      <% } else { %>
        <p class="complete-text">현재 보유한 재료만으로 만들 수 있습니다.</p>
      <% } %>

      <details>
        <summary>조리 방법 보기</summary>
        <div class="instructions"><%= recipe.instructions %></div>
      </details>
    </article>
  <% }) %>
</section>

<%- include('../partials/footer') %>
