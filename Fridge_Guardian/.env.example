# 개발용 예시 값입니다. 공유·운영 환경에서는 새로 만든 강한 비밀번호와 키를 사용하세요.
# 이 파일을 .env로 복사해서 쓰고, 실제 키가 들어간 .env는 커밋하지 마세요.

# ── 데이터베이스 ──────────────────────────────────────────────
MYSQL_PORT=3306
MYSQL_PASSWORD=fridge_dev_password
MYSQL_ROOT_PASSWORD=fridge_dev_root_password
# DB_URL은 비워 두면 `npm run db`(또는 Windows의 scripts/start-db.ps1)가 만든 프로젝트 DB(3307)를 자동으로 씁니다. Docker DB(3306)를 쓰면 아래 DB_URL을 지정하세요.
# 다른 DB를 쓸 때만 주석을 풀어 주세요. 직접 지정한 값이 자동 선택보다 우선합니다.
# DB_URL=jdbc:mysql://127.0.0.1:3306/fridge_guardian?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=fridge_app
DB_PASSWORD=fridge_dev_password

# ── 서버 ──────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
# 소셜 로그인이 끝난 뒤 돌아갈 프런트엔드 주소 (개발: Vite, 배포: Vercel 도메인)
FRONTEND_URL=http://localhost:3000
# HTTPS 환경에서는 true (Refresh Token 쿠키에 Secure 속성이 붙습니다)
COOKIE_SECURE=false
# 업로드한 식재료 사진을 저장할 폴더 (기본 ./uploads)
# UPLOAD_DIR=./uploads
# API_PROXY_TARGET=http://127.0.0.1:8080

# ── 인증(JWT) ─────────────────────────────────────────────────
# Base64로 인코딩한 32바이트 이상. 예) node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"  (Windows·macOS 공통)
# 비워 두면 서버를 켤 때마다 임시 키를 만들어 재시작하면 모두 로그아웃됩니다. 운영에서는 반드시 설정하세요.
JWT_SECRET=

# ── 소셜 로그인 (선택) ────────────────────────────────────────
# 키를 채운 제공자의 버튼만 활성화됩니다. 키가 없으면 버튼이 "준비 중"으로 비활성 표시됩니다.
# 직접 편집하지 않고 저장하려면: npm run setup:social  (Windows·macOS 공통)
# Redirect URI로 아래 주소를 각 콘솔에 등록하세요. (배포 시에는 실제 도메인으로)
#   Google: http://localhost:3000/auth/google/callback
#   Kakao:  http://localhost:3000/auth/kakao/callback   (동의 항목: 닉네임, 카카오계정(이메일))
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=


# ── 캐시(Redis, 선택) ─────────────────────────────────────────
# 기본은 서버 메모리(caffeine)입니다. Redis를 쓰려면 CACHE_TYPE=redis 로 바꾸고
# docker compose --profile redis up -d redis 로 Redis를 띄우세요. Redis가 죽어도 서비스는 DB로 계속 동작합니다.
CACHE_TYPE=caffeine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AI 레시피·채팅 (서버에서만 읽습니다. VITE_* 변수에 넣지 마세요) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 아래 한도는 이 서버 프로세스 기준이며 재시작하면 초기화됩니다. 실패한 호출도 횟수에 포함됩니다.
AI_USER_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=100
AI_CONCURRENT_REQUESTS=2

# ── 바코드 조회 (선택) ────────────────────────────────────────
# 식품안전나라 OpenAPI(바코드연계제품정보 C005) 인증키. 없으면 이미 저장된 결과만 사용하고 직접 입력을 안내합니다.
FOODSAFETY_API_KEY=

# ── 유통기한 알림 배치 ────────────────────────────────────────
# 서버를 여러 대 띄울 때 일부 인스턴스에서만 스케줄러를 켜려면 false로 바꿉니다.
SCHEDULER_ENABLED=true
