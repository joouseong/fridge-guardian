# 1단계: 빌드 스테이지 (Gradle 빌드)
FROM eclipse-temurin:17-jdk AS builder
WORKDIR /app

# Gradle 파일 복사
COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .

# 소스 코드 복사
COPY src src

# Gradle Wrapper를 통한 빌드 실행 (권한 부여 포함)
RUN chmod +x ./gradlew
RUN ./gradlew bootJar --no-daemon

# 2단계: 실행 스테이지
FROM eclipse-temurin:17-jre
WORKDIR /app

# 빌드 스테이지에서 생성된 jar 파일 복사 (파일명에 맞게 수정 필요 시 변경)
COPY --from=builder /app/build/libs/*.jar app.jar

# 포트 개방 (스프링 부트 기본 포트 8080)
EXPOSE 8080

# 애플리케이션 실행
ENTRYPOINT ["java", "-jar", "app.jar"]