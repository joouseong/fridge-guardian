# Local development values. Use new, strong passwords for any shared environment.
MYSQL_PORT=3306
MYSQL_PASSWORD=fridge_dev_password
MYSQL_ROOT_PASSWORD=fridge_dev_root_password

# Leave DB_URL unset for the default Docker DB (3306) or auto-detected Windows project DB (3307).
# Uncomment only to use a different database. An explicit URL overrides local auto-detection.
# DB_URL=jdbc:mysql://127.0.0.1:3306/fridge_gatekeeper?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=fridge_app
DB_PASSWORD=fridge_dev_password

# The Spring Boot process reads environment variables; Docker Compose reads .env.
# Keep the OpenAI key on the server. Never add it to VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Limits apply to this server process; restarting resets them. Failed attempts count too.
AI_USER_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=100
AI_CONCURRENT_REQUESTS=2

SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SESSION_COOKIE_SECURE=false
# API_PROXY_TARGET=http://127.0.0.1:8080
