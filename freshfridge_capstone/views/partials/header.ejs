<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | FreshFridge' : 'FreshFridge' %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a href="<%= user ? '/dashboard' : '/' %>" class="brand">FreshFridge</a>
    <nav>
      <% if (user) { %>
        <a href="/dashboard">대시보드</a>
        <a href="/ingredients">식재료 관리</a>
        <a href="/recipes">레시피 추천</a>
        <span class="welcome"><%= user.name %>님</span>
        <form action="/auth/logout" method="POST" class="inline-form">
          <button class="link-button" type="submit">로그아웃</button>
        </form>
      <% } else { %>
        <a href="/auth/login">로그인</a>
        <a class="btn btn-sm" href="/auth/register">회원가입</a>
      <% } %>
    </nav>
  </div>
</header>

<main class="container main">
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
  <% } %>
