<%- include('../partials/header', { title: '회원가입' }) %>
<section class="auth-wrap">
  <div class="auth-card">
    <h1>회원가입</h1>
    <p class="muted">FreshFridge를 시작해보세요.</p>
    <form action="/auth/register" method="POST" class="form">
      <label>이름
        <input type="text" name="name" placeholder="이름" required>
      </label>
      <label>이메일
        <input type="email" name="email" placeholder="example@email.com" required>
      </label>
      <label>비밀번호
        <input type="password" name="password" placeholder="6자 이상" minlength="6" required>
      </label>
      <label>비밀번호 확인
        <input type="password" name="passwordConfirm" placeholder="비밀번호 다시 입력" minlength="6" required>
      </label>
      <button class="btn btn-full" type="submit">회원가입</button>
    </form>
    <p class="auth-bottom">이미 계정이 있나요? <a href="/auth/login">로그인</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
