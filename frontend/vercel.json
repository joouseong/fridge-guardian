{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fridge-guardian.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://fridge-guardian.onrender.com/oauth2/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://fridge-guardian.onrender.com/auth/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://fridge-guardian.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|oauth2/|auth/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}