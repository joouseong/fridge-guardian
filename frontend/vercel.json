{
  "rewrites": [
    {
      "source": "/oauth2/:match*",
      "destination": "/api/oauth2/:match*"
    },
    {
      "source": "/auth/:provider/callback",
      "destination": "/api/oauth-callback/:provider"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api/uploads/:match*"
    },
    {
      "source": "/((?!api/|oauth2/|auth/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
